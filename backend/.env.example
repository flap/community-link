# Configuração do backend Community Link (prefixo CL_)

# Autenticação simplificada do MVP (RF-011) — troque em qualquer ambiente real
CL_ADMIN_TOKEN=dev-admin-token-change-me

# Persistência: true = repositório em memória (dev/testes); false = DynamoDB
CL_USE_IN_MEMORY_STORE=true

# DynamoDB (quando CL_USE_IN_MEMORY_STORE=false)
CL_DYNAMODB_TABLE=community-link
CL_AWS_REGION=us-east-1
# CL_DYNAMODB_ENDPOINT_URL=http://localhost:8000

# S3 (fotos de destaque / logos)
# CL_S3_BUCKET=community-link-assets

# Domínio público de produção
CL_PUBLIC_DOMAIN=awscommunity.com.br

# CORS (origens separadas por vírgula)
CL_CORS_ORIGINS=*
