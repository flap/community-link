# Configuração do backend Community Link (prefixo CL_)

# Autenticação (RF-022): "static" (dev/testes, credencial fixa) ou "supabase" (produção)
CL_AUTH_MODE=static
# Credencial fixa — usada apenas em CL_AUTH_MODE=static
CL_ADMIN_TOKEN=dev-admin-token-change-me

# Supabase Auth (RF-019) — usado em CL_AUTH_MODE=supabase
# CL_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Opcional: só para projetos legados com JWT HS256; se vazio, valida via JWKS (chaves assimétricas)
# CL_SUPABASE_JWT_SECRET=
# CL_SUPABASE_AUDIENCE=authenticated

# Persistência: true = repositório em memória (dev/testes); false = DynamoDB
CL_USE_IN_MEMORY_STORE=true

# DynamoDB (quando CL_USE_IN_MEMORY_STORE=false)
CL_DYNAMODB_TABLE=community-link
CL_AWS_REGION=us-east-1
# CL_DYNAMODB_ENDPOINT_URL=http://localhost:8000

# S3 (fotos de destaque / logos)
# CL_S3_BUCKET=community-link-assets
# Uploads locais em dev (quando não há bucket S3)
CL_MEDIA_DIR=./media
CL_MEDIA_BASE_URL=/api/media
CL_MAX_UPLOAD_BYTES=5242880
CL_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Domínio público de produção
CL_PUBLIC_DOMAIN=awscommunity.com.br

# CORS (origens separadas por vírgula)
CL_CORS_ORIGINS=*
