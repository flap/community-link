# Supabase Auth (RF-019 / RF-020). Sem estas variáveis o frontend opera no modo
# "static" de desenvolvimento (credencial fixa do backend).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key
# Provedores sociais exibidos na tela de login (habilite-os no painel do Supabase)
VITE_SUPABASE_PROVIDERS=google,github
